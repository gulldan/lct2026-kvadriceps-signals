{
  "name": "rag-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings && bun run lint:ast && bun scripts/check-conventions.ts && bun run lint:design && bun scripts/check-i18n-keys.ts && bun scripts/check-copy.ts",
    "fmt": "oxfmt --ignore-path .oxfmtignore . && cd .. && oxfmt --config frontend/.oxfmtrc.json DESIGN.md",
    "fmt:check": "oxfmt --check --ignore-path .oxfmtignore . && cd .. && oxfmt --config frontend/.oxfmtrc.json --check DESIGN.md",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:ast && bun test src scripts",
    "knip": "knip --treat-config-hints-as-errors",
    "audit": "bun audit",
    "size": "size-limit",
    "e2e": "playwright test",
    "a11y": "playwright test -g @a11y",
    "verify": "bun run fmt:check && bun run lint && bun run typecheck && bun run knip && bun run audit && bun run test && bun run build && bun run size",
    "lint:design": "bun scripts/check-design-system.ts",
    "ui-kit": "vite --open /ui-kit.html",
    "test:ui": "playwright test --config playwright.ui-kit.config.ts",
    "verify:ui": "bun run verify && bun run test:ui",
    "lint:ast": "ast-grep scan --config sgconfig.yml src",
    "test:ast": "ast-grep test --config sgconfig.yml --skip-snapshot-tests",
    "hooks:install": "lefthook install",
    "taxonomy:generate": "bun scripts/research-taxonomy.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "i18next": "^26.4.2",
    "katex": "0.18.7",
    "lucide-react": "^1.42.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "react-router-dom": "^7.18.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "oxc-parser": "^0.149.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "katex": "0.18.7",
    "pdfjs-dist": "6.3.289"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
