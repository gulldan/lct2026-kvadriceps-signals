# Template for infra/.env. `make up` creates infra/.env automatically and fills
# the required local secrets when they are blank.
# Most infra URLs are wired in docker-compose.yml; this file is mainly for
# secrets, host-port overrides, and optional model endpoint overrides.

LOG_LEVEL=info
WORKER_CONCURRENCY=4

# Host ports (change if something already runs on these). Internal datastores
# (postgres/valkey/qdrant/opensearch) are NOT published — reach them via
# `docker compose exec`. The API gateway, frontend, and loopback-only local S3
# endpoint are the normal host entrypoints for local browser testing.
HTTP_PORT=8080
FRONTEND_PORT=5173
# HTTPS: make deploy автоматически добавит docker-compose.https.yml, если задан сертификат.
# Нужна доверенная браузерами цепочка для имени из STAND_URL. Ключ в Git не добавлять.
# Порты отдельные: 443 хоста может быть занят другим проектом. См. docs/deployment_guide.pdf.
FRONTEND_TLS_CERT=
FRONTEND_TLS_KEY=
FRONTEND_TLS_BIND=127.0.0.1
FRONTEND_HTTPS_PORT=8443
S3_HTTPS_PORT=8444
# Empty FRONTEND_PUBLIC_API keeps WebSocket/API traffic same-origin through the
# frontend nginx proxy. Set it only when the browser must connect elsewhere.
FRONTEND_PUBLIC_API=
RABBITMQ_UI_PORT=15672
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Auth / seeded admin. `make up` fills these before the first compose run.
# ВАЖНО: JWT_SECRET должен быть сильным (32+ случайных байта). `make up`
# генерирует его автоматически; auth и main-service откажутся стартовать без
# JWT_SECRET или на старом небезопасном значении 'dev-secret-change-me'.
JWT_SECRET=
# Для локального HTTP явно false; публичный контур требует HTTPS и true.
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=
WS_ALLOWED_ORIGINS=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Публичный стенд: саморегистрация из интернета закрыта по умолчанию. true →
# POST /register принимается только с валидным admin-токеном (создание юзеров
# из админки работает). Ставьте false только для локального dev/e2e-контура.
REGISTRATION_ADMIN_ONLY=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=
POSTGRES_PASSWORD=

# Local S3-compatible object store credentials (SeaweedFS).
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Резерв свободного диска: процент или абсолютный размер; по умолчанию 1 %.
SEAWEEDFS_MIN_FREE_SPACE=1
# Default S3_PUBLIC_ENDPOINT is http://localhost:4566 and works only when the
# browser runs on the same host. For a remote browser, publish S3 through an
# authenticated/TLS edge and set S3_PUBLIC_ENDPOINT to that external URL.
S3_PUBLIC_ENDPOINT=

# Shared knowledge base: every signed-in user searches the whole corpus and
# may preview any indexed document (chats/uploads stay private). Set to false
# for strict per-owner tenant isolation.
RAG_SHARED_CORPUS=true

# Live radar uses dedicated Go collectors and reads their shared snapshot.
# Date windows are resolved from the UTC collection date, including this month.
RADAR_EXTERNAL_COLLECTOR=true
# Optional trained classifier: exact prediction endpoint and immutable artifact version.
# Empty URL keeps candidates explicitly unscored; it never substitutes rule coverage.
RADAR_CLASSIFIER_URL=
RADAR_CLASSIFIER_VERSION=
# Радар: сколько обращений к шлюзу идут одновременно (пусто = 48) и клиентский
# темп запросов в минуту (пусто = 0, без троттлинга). Меняются из админки без перезапуска.
RADAR_LLM_WORKERS=
RADAR_LLM_RPM=
# ML-извлечение включается отдельно; URL содержит полный путь POST-обработчика.
RADAR_CANDIDATE_SOURCE=ngrams
RADAR_ML_EXTRACT_URL=
RADAR_ML_EXTRACT_TIMEOUT=300s
# Пределы полного корпуса согласуются с EXTRACTOR_MAX_EXTRACT_REQUEST_BYTES сервиса.
# Контракт /predict остаётся 4 МиБ. Увеличивать только после оценки памяти сервера.
RADAR_ML_EXTRACT_MAX_REQUEST_BYTES=4194304
RADAR_ML_EXTRACT_MAX_RESPONSE_BYTES=1048576
# Пустое значение означает RADAR_CLASSIFIER_VERSION.
RADAR_ML_EXTRACT_VERSION=
# Извлечение технологий: docker compose --profile ml-extractor up -d --build extractor.
# Для main-service: RADAR_CANDIDATE_SOURCE=ml,
# RADAR_ML_EXTRACT_URL=http://extractor:8080/extract, RADAR_CLASSIFIER_URL пустой.
# Режим ml заменяет только извлечение: кандидатов extractor проверяет, называет и
# оценивает общий путь, а вердикт даёт встроенная модель main-service — у неё есть
# метрика на датасете ТЗ. /predict без признаков /extract ставит кандидату 0 %.
# RADAR_CLASSIFIER_VERSION — service_version из release.json бандла. Compose передаёт
# её и в extractor: непустое значение, не совпавшее с бандлом, не даёт ему запуститься.
# При пустом RADAR_CLASSIFIER_URL классификатор её не читает, она остаётся только
# версией /extract, если пуст RADAR_ML_EXTRACT_VERSION.
# Бандл lct-models-20260923-v1.2.tar.gz (1,74 ГиБ, Google Drive): теггер v1,
# модель стадии v3 с калибровкой, service_version weak-signal-2026-09-23.5.
# Для режима ml задайте RADAR_CLASSIFIER_VERSION=weak-signal-2026-09-23.5.
EXTRACTOR_MODEL_BUNDLE_URL=https://drive.google.com/open?id=1-xwa7RdB81EyVThZ_4Lus5AXGar4MNdp
EXTRACTOR_MODEL_BUNDLE_SHA256=ad468351805715038cf79a1d9ca8bb15575ba51603143b5096b43c97c5e3c499
EXTRACTOR_EMBEDDING_URL=http://f2llm-service:8085
# DSN кэша спанов Compose собирает из POSTGRES_PASSWORD; вне Compose — EXTRACTOR_POSTGRES_DSN.
# Веса сохраняются в именованном томе extractor-models.
# Образ по умолчанию — torch 2.8.0+cu128 и NVIDIA runtime, как у f2llm-service.
# CPU: EXTRACTOR_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu, EXTRACTOR_DEVICE=cpu
# и оверлей Compose без `runtime: nvidia`.
EXTRACTOR_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
EXTRACTOR_DEVICE=cuda
# Внимание и точность на CUDA (CPU всегда eager/fp32). Прежний режим: eager и fp32.
# bf16 — только после проверки паритета на целевом GPU, отдельно для теггера или E5.
EXTRACTOR_CUDA_DTYPE=fp32
EXTRACTOR_CUDA_ATTENTION=sdpa
EXTRACTOR_TAGGER_CUDA_DTYPE=
EXTRACTOR_STAGE_CUDA_DTYPE=
# Размеры батчей под GPU (по умолчанию 16 / 8 / 64): на 24 ГБ и больше можно поднять.
EXTRACTOR_TAGGER_BATCH_SIZE=16
EXTRACTOR_STAGE_BATCH_SIZE=8
EXTRACTOR_EMBEDDING_BATCH_SIZE=64
# Одновременные вызовы модели: отдельно для /extract и для /predict.
EXTRACTOR_SLOTS=1
EXTRACTOR_PREDICT_TIMEOUT=27
# Серверный срок /extract, секунды; меньше RADAR_ML_EXTRACT_TIMEOUT.
EXTRACTOR_EXTRACT_TIMEOUT=290
# Scientific document ingestion (--profile signalgraph): UUID of an existing
# operator account. Required for dispatching collected records into the corpus.
HARVEST_OWNER_ID=
HARVEST_INTERVAL=6h

# Interactive-vs-batch QoS. RAG_MAX_CONCURRENT bounds simultaneous RAG
# pipelines in llm-service (queue up to RAG_QUEUE_WAIT, then 503);
# INGEST_YIELD_MAX_WAIT is how long chunk-splitter yields per document while
# user queries are in flight (then it trickles — ingestion never starves).
RAG_MAX_CONCURRENT=16
RAG_QUEUE_WAIT=10s
RAG_GENERATE_TIMEOUT=150s
INGEST_YIELD_MAX_WAIT=2s
# Chunks per embed->upsert->index round-trip in chunk-splitter: bounds worker
# memory and backend request sizes for very large documents.
EMBED_BATCH=64

# ---------------------------------------------------------------------------
# Neural network endpoints.
# Embeddings and OCR are wired to internal compose services by default:
# f2llm-service and paddleocr-vl-service. Override these only when using an external
# engine. Generation/VLM remain external unless VLLM_URL/VLM_ENGINE_URL are set.
# ---------------------------------------------------------------------------

# Embeddings (F2LLM-v2). Expected: POST {url}
#   req {"model":..,"input":[texts]}  resp {"data":[{"embedding":[...]}]}
EMBEDDINGS_URL=http://f2llm-service:8085/v1/embeddings
EMBEDDINGS_MODEL=codefuse-ai/F2LLM-v2-0.6B
# Must match what the model outputs. Writer & reader must agree.
EMBEDDING_DIM=1024
F2LLM_MODEL=codefuse-ai/F2LLM-v2-0.6B
F2LLM_MAX_TOKENS=512
F2LLM_TORCH_DEVICE=cuda

# Generation (OpenAI-compatible engine). Calls {url}/v1/chat/completions —
# base URL БЕЗ /v1. Empty VLLM_URL = generation stub.
# Полностью локальный вариант (llama.cpp, профиль local-llm в compose):
#   docker compose -f infra/docker-compose.yml --profile local-llm up -d llama-server
# VLLM_URL=http://llama-server:8090
# VLLM_API_KEY=
# LLAMA_GGUF_DIR=../models/gguf
# LLAMA_GGUF_MODEL=Qwen3-30B-A3B-Q4_K_M.gguf
# Yandex AI Studio, OpenAI-совместимый контур организаторов.
# Модель задаётся URI вида gpt://<folder_id>/<model>/latest.
# Список доступных моделей можно проверить через scripts/check-llm.sh после
# заполнения VLLM_API_KEY.
# VLLM_URL=https://llm.api.cloud.yandex.net
# VLLM_API_KEY=<Api-Key от организаторов>
# Разрешённые ТЗ модели каталога, например YandexGPT Pro 5 — gpt://<folder_id>/yandexgpt/latest,
# Qwen3 235B — gpt://<folder_id>/qwen3-235b-a22b-fp8/latest; точное имя сверить с каталогом.
# VLLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# LLM_MODEL_DISPLAY_NAME=YandexGPT Pro 5
VLLM_URL=
VLLM_API_KEY=
VLLM_MODEL=qwen3-35b-a3b
# Подпись модели в интерфейсе и выгрузках. Пусто — умолчание кода «DeepSeek V4 Flash (локальная)»,
# имя модели стенда: после смены VLLM_MODEL задайте своё, иначе новая модель получит чужую подпись.
LLM_MODEL_DISPLAY_NAME=
# Мягкий клиентский темп (запросов/мин на инстанс; 0 = без троттлинга).
# Yandex AI Studio: RPM-квот нет. Есть лимит на одновременные генерации.
# Значение 60 сглаживает всплески запросов на одном инстансе.
# 0 — без темпа на клиенте: корпоративный шлюз без лимитов держит 256 одновременных запросов.
VLLM_RPM=60
# Optional OpenAI reasoning policy; empty keeps the provider default.
# Set none for corporate Qwen gateways when interactive structured tasks time out.
VLLM_REASONING_EFFORT=
# Версия кэша ответов; пустое значение использует версию из docker-compose.yml.
RAG_PIPELINE_REVISION=
# Лимиты для шкалы «Запросы сегодня» на дашборде метрик.
# 0 означает, что лимита нет и шкала скрывается.
LLM_DAILY_LIMIT=0
LLM_PER_MIN_LIMIT=0

# Учёт затрат LLM на дашборде «Метрики». Провайдеры без usage.cost в ответе
# (например, Yandex AI Studio) оцениваются по прайсу: цена за 1 млн токенов в
# валюте провайдера. Значения — из актуального прайса Yandex Cloud
# (https://yandex.cloud/ru/docs/ai-studio/pricing), цены не выдумывать.
# По-модельная таблица цен (подстрока имени = вход/выход за 1M; первый матч
# побеждает; явный 0/0 — известно-бесплатная модель). Пара LLM_PRICE_*_PER_1M
# ниже — фолбэк для моделей вне списка.
# LLM_PRICES="deepseek-v4-flash=300/500;qwen3.6=500/500;:free=0/0"
# LLM_PRICE_PROMPT_PER_1M=<цена 1 млн входных токенов, см. прайс Yandex Cloud>
# LLM_PRICE_COMPLETION_PER_1M=<цена 1 млн выходных токенов, см. прайс Yandex Cloud>
# LLM_COST_CURRENCY=₽
# Разбивка расхода по провайдерам: подстрока имени модели → ключ:подпись:валюта:вид,
# вид real (реальные деньги) / notional (оценка по прайсу) / free. Пятое поле — имя,
# под которым строки показываются в таблице моделей; `*` ловит любую модель, так один
# локально развёрнутый движок забирает и историю прежних провайдеров.
# LLM_PROVIDERS="*=local:Локальный ИИ:₽:notional:local/deepseek-v4-flash-abliterated"
# Общий бюджет в валюте провайдера — на дашборде остаток = бюджет − расход.
# LLM_BUDGET_TOTAL=<сумма бюджета>

# Materials Project API key (https://next-gen.materialsproject.org/api) for
# computed novelty / prior-art sanity checks. Empty = the MP client is a safe stub.
MP_API_KEY=

# Публикации для блока «мировая практика» (OpenAlex + Crossref). OpenAlex требует
# mailto (polite pool): пустой PUBSEARCH_MAILTO — источник пропускается, работает
# только Crossref. PUBSEARCH_ENABLED=false выключает поиск целиком.
# Адреса, ключи и контакты читаются только из окружения и не возвращаются в интерфейс.
# Модели, цены и флаги качества можно менять в «Параметрах платформы».
PUBSEARCH_MAILTO=
# Живые тренды (/trends): токен GitHub повышает лимит поиска с 10 до 30 запросов/мин.
GITHUB_TOKEN=
# Полнотекстовый поиск SEC EDGAR требует в User-Agent имя и контактный адрес
# владельца клиента («Компания admin@example.com»), иначе архив отвечает 403.
# Пусто — нейтральная строка проекта без личного адреса.
SEC_EDGAR_USER_AGENT=
# Токен разработчика Product Hunt API v2. Условия API запрещают коммерческое
# использование без согласования с Product Hunt. Пусто — источник запусков
# выключен и назван в ограничениях ответа радара.
PRODUCTHUNT_TOKEN=

# --- Доступы поставщиков (OPS-02). Значений здесь нет и быть не должно: ключи
# живут только в infra/.env на сервере. Отсутствие доступа читается как
# ограничение покрытия, а не как измеренный ноль.
# EPO OPS (Consumer Key / Consumer Secret приложения на developers.epo.org):
# мировой патентный охват (DOCDB, 100+ ведомств) по терминам patent_terms с
# семействами DOCDB, датами подачи и приоритета и аннотациями. Бесплатно 4 ГБ
# в неделю на регистрацию; поиск троттлится (15…30 запросов/мин, см.
# X-Throttling-Control). Без ключей мировой scope выключен и назван в limits.
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Роспатент, ИС «Поисковая платформа» (API-ключ из личного кабинета
# searchplatform.rospatent.gov.ru): российские публикации по patent_terms в
# наборе ru_since_1994. Квоты спецификация не называет; сборщик держит один
# запрос в секунду. Пусто — российский scope выключен и назван в limits.
ROSPATENT_API_KEY=
# Прокси для исходящих запросов сборщиков источников (patent-collector), если
# провайдеры не отвечают напрямую: http://host:port, https:// или socks5://.
# Пусто — прямые запросы; панель доменов проверяется в обоих случаях.
SOURCE_PROXY_URL=
# OpenAlex: бесплатный ключ (openalex.org/settings/api) даёт 1 $ в сутки =
# 10 000 запросов против 1 000 без ключа; сброс в 00:00 UTC. Используется
# цитируемостью радара, поиском мировой практики и обогащением DOI.
OPENALEX_API_KEY=
# mailto «вежливого пула» OpenAlex (необязателен при ключе) и отдельный прокси
# для OpenAlex (http/https/socks5), если api.openalex.org не отвечает напрямую.
OPENALEX_MAILTO=
OPENALEX_PROXY_URL=
# Абсолютный путь к PEM с корнями частного CA (плюс публичные корни) — нужен,
# когда VLLM_URL за корпоративным сертификатом. Непустое значение включает
# оверлей infra/docker-compose.corp-ca.yml; Makefile подхватывает его сам.
RAG_CA_BUNDLE=
PUBSEARCH_ENABLED=true

# Reranker (Qwen3-Reranker). Expected: POST {url}
#   req {"model":..,"query":..,"documents":[..]}
#   resp {"scores":[..],"results":[{index,relevance_score}]}
RERANKER_URL=http://reranker-service:8086/v1/rerank
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_SERVICE_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_TORCH_DEVICE=cuda
RERANKER_MAX_TOKENS=4096
RERANKER_BATCH=8

# OCR (PaddleOCR-VL). Expected: POST {url}
#   req {"model":..,"image_b64":..,"mime":..}  resp {"text":..}
OCR_ENGINE_URL=http://paddleocr-vl-service:8088
OCR_MODEL=PaddleOCR-VL

# Workbook parser for XLSX/XLSM/XLTX/XLTM. Empty WORKBOOK_PARSER_URL disables
# structured parsing and falls back to legacy flat text extraction in office-parser.
WORKBOOK_PARSER_URL=http://workbook-parser-service:8095
WORKBOOK_MAX_UPLOAD_MB=128
WORKBOOK_PARSER_LOG_LEVEL=info

# Куда роутить загруженные изображения: ocr (локальный OCR) или vlm
# (Yandex Qwen3.6 / мультимодальное описание схем и сканов — см. VLM_* ниже).
IMAGE_PARSE_ROUTE=ocr

# Vision-language (Qwen-VL). Native protocol: POST {url}
#   req {"model":..,"image_b64":..,"mime":..,"prompt":..}  resp {"text":..}
# VLM_API_STYLE=openai switches to OpenAI vision chat/completions: base URL
# without /v1, image as data-URI image_url, VLM_API_KEY as Bearer.
# Yandex AI Studio для ключей организаторов:
# VLM_ENGINE_URL=https://llm.api.cloud.yandex.net
# VLM_MODEL=gpt://<folder-id>/qwen3.6-35b-a3b/latest
# VLM_API_STYLE=openai
# VLM_API_KEY=<Api-Key от организаторов>
# IMAGE_PARSE_ROUTE=vlm
VLM_ENGINE_URL=
VLM_MODEL=qwen3.5-9b
VLM_API_STYLE=native
VLM_API_KEY=

# Local non-LLM diagram parser for technological schemes. It uses OpenCV for
# block/connector extraction. The default service keeps the previous
# PaddleOCR-VL flow.
# Enable the existing flow with:
#   IMAGE_PARSE_ROUTE=vlm
#   VLM_ENGINE_URL=http://diagram-parser-service:8089
#   VLM_MODEL=diagram-opencv-paddle
#   docker compose --profile diagram-parser up -d diagram-parser-service vlm-service
# Enable local GPU PP-OCRv5 labels with:
#   IMAGE_PARSE_ROUTE=vlm
#   VLM_ENGINE_URL=http://diagram-parser-paddle5-service:8089
#   VLM_MODEL=diagram-opencv-paddle
#   docker compose --profile diagram-parser-paddle5 up -d diagram-parser-paddle5-service vlm-service
# Modes full-image/tiles4/tiles9 call DIAGRAM_OCR_URL and require the
# paddleocr-vl-service container. The paddle5 service does not call DIAGRAM_OCR_URL.
DIAGRAM_OCR_URL=http://paddleocr-vl-service:8088
DIAGRAM_OCR_MODEL=PaddleOCR-VL
DIAGRAM_OCR_TIMEOUT=90
DIAGRAM_OCR_MODE=full-image
DIAGRAM_PADDLE5_LANG=ru
DIAGRAM_PADDLE5_DEVICE=gpu
DIAGRAM_PADDLE5_DET_MODEL=PP-OCRv5_server_det
DIAGRAM_PADDLE5_REC_MODEL=eslav_PP-OCRv5_mobile_rec
DIAGRAM_PADDLE5_REC_BATCH_SIZE=8
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
DIAGRAM_BLOCK_OCR_MAX_BLOCKS=12
DIAGRAM_TILE_OCR_TIMEOUT=45
DIAGRAM_TILE_OVERLAP_PX=32
DIAGRAM_PARSE_CONCURRENCY=1
DIAGRAM_FAIL_OPEN=false

# Background jobs.
CLUSTER_CHECK_INTERVAL=15
CLUSTER_DEBOUNCE_SEC=45
# Clustering tunables (see cluster-worker/README.md).
CLUSTER_KNN_K=6
CLUSTER_KNN_BLOCK_SIZE=512
CLUSTER_RESOLUTION=1.0
CLUSTER_MIN_SIZE=2
# Drop graph edges below this cosine similarity (0.0 keeps every mutual-kNN pair).
CLUSTER_SIM_THRESHOLD=0.0
# true = mutual kNN (tight themes); false = union kNN (denser graph, larger clusters).
CLUSTER_MUTUAL_KNN=true
LAST_CLUSTERED_KEY=rag:clusters:last_epoch
AUTO_HYPOTHESES=true
AUTO_HYPOTHESIS_LIMIT=24
ITC_TRIGGER_KEY=rag:itc:trigger
# Scheduled RAG evaluation spends generation/judge calls. Keep it off in the
# shipped example; admins can still trigger a run from the metrics page.
EVAL_INTERVAL_SEC=0
EVAL_STARTUP_DELAY_SEC=120
EVAL_CHECK_INTERVAL_SEC=10
EVAL_HYPOTHESES=0
EVAL_DISCOVERY=1
ITC_INTERVAL_SEC=3600
ITC_STARTUP_DELAY_SEC=180

# Изолированный браузер: один секрет сервера и клиента, генерируется make env.
RENDER_URL=http://page-renderer:3000/content
RENDER_TOKEN=

# Локальные параметры оператора; реальные значения только в игнорируемом env-файле.
STAND_URL=
STAND_USER=
STAND_PASSWORD=
STAND_TOKEN=
STAND_ENV_FILE=
STAND_RADAR_DIR=
